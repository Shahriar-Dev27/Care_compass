# Copy to .env — never commit the real file.
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id ending in :free works. Swap it if one is rate-limited.
# meta-llama/llama-3.3-70b-instruct:free | deepseek/deepseek-chat-v3-0324:free | google/gemma-3-27b-it:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Sent to OpenRouter for attribution.
OPENROUTER_SITE_URL=http://localhost:5173

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API. Both values are safe in the browser:
# every table is behind row level security, so the session decides what loads.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
